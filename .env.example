APP_NAME=Hue Food Recommender API
DEBUG=true

# MySQL (driver PyMySQL). Tạo DB trước: CREATE DATABASE hue_food CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+pymysql://root:matkhau@localhost:3306/huetaste?charset=utf8mb4

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Reset password
RESET_TOKEN_EXPIRE_MINUTES=30
# Link mở trong app/web, token được nối vào cuối
RESET_PASSWORD_URL=http://localhost:3000/reset-password?token=

# CORS: danh sách origin cách nhau bởi dấu phẩy (ReactJS admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SMTP (để trống SMTP_HOST => email chỉ được log ra console, dùng cho dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@hue-food.local

# LLM: thứ tự nhà cung cấp, chưa có key thì bỏ qua. Mỗi bước pipeline có thứ tự riêng (xem claude/08)
LLM_THU_TU=groq,gemini
LLM_THU_TU_DANH_SACH=gemini,groq
LLM_THU_TU_TAG=groq,gemini
GROQ_API_KEY=

# Gemini API (lấy key ở Google AI Studio - gói Gemini Plus trên app KHÔNG phải API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_DU_PHONG=gemini-3.5-flash-lite,gemini-flash-latest
GEMINI_MAX_TOKEN_RA=8192
# Scan ảnh món (POST /scan): model vision free, thử lần lượt; giới hạn số lượt scan/người/ngày
GEMINI_MODEL_SCAN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-26b-a4b-it
SCAN_TIMEOUT_GIAY=20
SCAN_TOI_DA_MOI_NGAY=30
SCAN_CHO_LAM_GIAU_GIAY=120
# Serper (serper.dev) - tìm quán ăn trên Google Maps
SERPER_API_KEY=
WIKI_USER_AGENT=HueTasteBot/0.1 (do-an-tot-nghiep; contact: admin@hue-food.local)

# Worker thu thập dữ liệu (cron: phút giờ ngày tháng thứ)
THU_THAP_SO_MON=120
THU_THAP_QUAN_MOI_MON=8
# Ảnh phụ của món/quán (Serper Images)
THU_THAP_ANH_BAT=true
THU_THAP_SO_ANH_MON=6
THU_THAP_SO_ANH_QUAN=5
LICH_MON_AN=0 3 1 * *
LICH_DIA_DIEM=0 3 * * 1
